venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
__pycache__/
*/__pycache__/
*/**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Next.js & Frontend Builds
.next/
*/.next/
out/
*/out/
dist/
*/dist/
.vercel/

# TypeScript & Cache
*.tsbuildinfo
next-env.d.ts

# Environment Variables & Secrets (CRITICAL)
.env
.env*
!.env.example
*.local
*.pem
*.key

# Operating System & IDE
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# Temporary & logs
logs/
*.log
